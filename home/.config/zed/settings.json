      "vim.visual.foreground": "#2E3440",
      "vim.visual_line.foreground": "#2E3440",
      "vim.visual_block.foreground": "#2E3440",

      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
    "Monokai Pro (CE)": {
      "vim.normal.background": "#78DCE8",
      "vim.insert.background": "#A9DC76",
      "vim.replace.background": "#FF6188",
      "vim.visual.background": "#AB9DF2",
      "vim.visual_line.background": "#AB9DF2",
      "vim.visual_block.background": "#FC9867",

      "vim.normal.foreground": "#2D2A2E",
      "vim.insert.foreground": "#2D2A2E",
      "vim.replace.foreground": "#2D2A2E",
      "vim.visual.foreground": "#2D2A2E",
      "vim.visual_line.foreground": "#2D2A2E",
      "vim.visual_block.foreground": "#2D2A2E",

      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
    "One Dark Pro": {
      "border": "#23272E",
      "border.variant": "#23272E",
    },
    "Everforest Dark Medium (material)": {
      "border": "#2d353b",
      "border.variant": "#2d353b",
    },
    "Flexoki Dark": {
      "border": "#100f0f",
      "border.variant": "#100f0f",
      "title_bar.background": "#100f0f",
      "panel.background": "#100f0f",
    },
    "Aura Dark": {
      "border.variant": "#15141C",
      "border": "#15141C",
      "title_bar.background": "#15141C",
      "panel.background": "#15141C",
      "pane.focused_border": "#4E466E",
      "players": [
        {
          "cursor": "db9dff",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
    "One Dark": {
      "title_bar.background": "#1e2127",
      "panel.background": "#1e2127",
      "pane.focused_border": "#61afef",

      "vim.normal.background": "#61afef",
      "vim.insert.background": "#98c379",
      "vim.replace.background": "#e06c75",
      "vim.visual.background": "#c678dd",
      "vim.visual_line.background": "#c678dd",
      "vim.visual_block.background": "#e5c07b",

      "vim.normal.foreground": "#1e2127",
      "vim.insert.foreground": "#1e2127",
      "vim.replace.foreground": "#1e2127",
      "vim.visual.foreground": "#1e2127",
      "vim.visual_line.foreground": "#1e2127",
      "vim.visual_block.foreground": "#1e2127",

      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  "title_bar": {
    "show_user_menu": true,
    "show_user_picture": true,
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
  },
  "tab_bar": {
    "show": false,
  },
  "tabs": {
    "file_icons": true,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "active_language_button": false,
    "cursor_position_button": false,
    "experimental.show": false,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 400,
    "hide_root": true,
    "auto_fold_dirs": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 300,
    "indent_guides": {
      "show": "never",
    },
  },
  "file_finder": {
    "modal_max_width": "large",
    "include_ignored": "all",
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "breakpoints": false,
  },
  "indent_guides": {
    "enabled": false,
  },
}
